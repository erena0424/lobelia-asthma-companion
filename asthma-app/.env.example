# LLM advice (Claude and/or Gemini)
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-3-5-haiku-latest
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=claude

# Episode memory embeddings (hybrid retrieval). Prefer Gemini (reuses GEMINI_API_KEY).
# Use stub for tests/CI with no API calls.
EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=models/text-embedding-004
# EMBEDDING_PROVIDER=stub

# Local debugging only — adds debug.retrieved_episodes / insights / calendar to
# forecast and advice JSON. Leave unset/false in production.
# COPILOT_DEBUG=1

# Database — local Docker Compose (default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mirror_lake
# Optional direct URL for Alembic DDL (required on Neon/Supabase when DATABASE_URL is a pooler)
# DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/mirror_lake

# Database — staging/production (Neon example)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Database — staging/production (Supabase example)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# Test database (pytest; optional separate DB)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mirror_lake_test

# JWT (auth) — required; placeholder value is rejected at startup
JWT_SECRET=dev_local_change_me_before_deploy
JWT_EXPIRE_MINUTES=10080

# Resend email delivery for auth codes
RESEND_API_KEY=your_resend_key_here
RESEND_FROM_EMAIL=Lobelia <noreply@lobelia.app>
# Inbox for feedback and for replies to user emails
SUPPORT_EMAIL=support@lobelia.app

# Environment data providers
OPENWEATHER_API_KEY=your_openweather_key_here
GOOGLE_POLLEN_API_KEY=your_google_pollen_key_here
# Deprecated alias (still supported): GOOGLE_MAPS_API_KEY=

# Provider selection: openmeteo (free, no key) or openweather (best AAMOS parity)
ENV_PROVIDER=openmeteo

# Cache TTL in seconds (default 21600 = 6 hours for today; past dates use 7 days)
ENV_CACHE_TTL_SECONDS=21600

# CORS — comma-separated browser origins (Vite + deployed frontend)
# LAN phone testing is also covered by an origin regex in api/main.py.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# Google Calendar OAuth (free Calendar API — read-only)
# Create at https://console.cloud.google.com/ → APIs → Google Calendar API + OAuth client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/v1/calendar/callback
# After OAuth: API page works without Vite. Prefer FE HashRouter when demoing UI:
# GOOGLE_OAUTH_FRONTEND_REDIRECT=http://127.0.0.1:5173/Mirror-Lake/?calendar=connected#/oauth-done
GOOGLE_OAUTH_FRONTEND_REDIRECT=http://127.0.0.1:8000/v1/calendar/oauth-done
